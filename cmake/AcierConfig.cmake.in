@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Arrow CONFIG)
find_dependency(ArrowAcero CONFIG)
find_dependency(ArrowDataset CONFIG)
if(ARROW_VERSION VERSION_LESS 21.0.0)
  set(Acier_FOUND FALSE)
  set(Acier_NOT_FOUND_MESSAGE "Acier requires Arrow 21.0.0 or newer")
  return()
endif()

if(NOT ARROW_VERSION VERSION_EQUAL "@ARROW_VERSION@")
  set(Acier_FOUND FALSE)
  set(Acier_NOT_FOUND_MESSAGE
      "Acier was compiled against Arrow @ARROW_VERSION@; rebuild Acier for Arrow ${ARROW_VERSION}")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AcierTargets.cmake")
check_required_components(Acier)
